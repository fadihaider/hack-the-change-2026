# Non-secret defaults and the full variable contract (docs/IMPLEMENTATION.md section 11).
# Copy to .env.local for local development. Never commit .env.local or real credentials.
# The AWS project only allows resources in us-east-2; other regions are denied by the project policy.

# config (Amplify env vars when deployed, copied into .env.production by amplify.yml)
APP_AWS_REGION=us-east-2
BEDROCK_REGION=us-east-2
# Claude through the Bedrock runtime with the US cross-region profile (bedrock-mantle has no Claude in us-east-2)
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=reliefready
S3_BUCKET=
APP_SECRET_ARN=
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
AUTH_TRUST_HOST=true
ADMIN_EMAILS=
ELEVENLABS_VOICE_ID=
# config, P1 (Scheduler)
SCHEDULER_ROLE_ARN=
DISPATCHER_LAMBDA_ARN=

# secrets: keys of the Secrets Manager secret reliefready/app when deployed; locally in .env.local only
AUTH_SECRET=
GOOGLE_CLIENT_SECRET=
APP_ENC_KEY=
ELEVENLABS_API_KEY=
SOCRATA_APP_TOKEN=
# salt for hashing client IPs in rate limits (lib/rateLimit.ts)
RATE_LIMIT_SALT=
# secret, P1 (Scheduler)
INTERNAL_WEBHOOK_SECRET=
