# ReliefReady environment contract: names and non-secret defaults only.
# The local demo needs nothing here. Leave everything blank and run `npm run dev`.
# For local live testing, copy the lines you need into .env.local (git-ignored). Never commit real values.
# Every comment sits on its own line, because dotenv parsers treat inline comments differently.
# Steps to switch each provider on, and what each failure looks like: docs/INTEGRATIONS.md.

# ---------------------------------------------------------------------------
# Adapter switches (lib/mvp/runtime.ts, lib/ai/provider.ts). Blank means the first value listed.
# ---------------------------------------------------------------------------
# pglite | supabase. pglite is in-process Postgres (PostGIS, pgvector, pgcrypto) stored in .data/pglite, for offline work
# supabase is the cloud database (SUPABASE_DB_URL below)
RR_DB=
# demo | anthropic | bedrock | gemini. demo is offline keyword rules, not Claude or any other model
# (gemini is being added; verify that lib/ai/provider.ts accepts it before using it)
RR_AI=
# outbox | gmail. outbox stores messages in the database and shows them at /outbox; nothing is emailed
# gmail needs Google sign-in (RR_AUTH=google), which is not wired yet
RR_MAIL=
# seed | google. seed is 6 fictional calendar events; google has the same Google sign-in caveat
RR_CALENDAR=
# demo | google. demo signs every visitor in as the fictional Alex (alex@example.test)
# google is a stub today: every request is signed out, so every API call returns 401
RR_AUTH=
# off | bedrock. embeddings for approved care facts; off means keyword retrieval over approved facts only
# bedrock uses Amazon Titan Text Embeddings V2 (1024 dimensions) in the project Region
RR_EMBED=
# Bedrock embedding overrides. EMBED_REGION blank means BEDROCK_REGION; EMBED_MODEL_ID blank means Titan V2
EMBED_REGION=
EMBED_MODEL_ID=
# on | blank. on enables POST /api/voice-agent/session for the optional hosted ElevenLabs companion (/voice)
RR_VOICE_AGENT=

# ---------------------------------------------------------------------------
# Local server
# ---------------------------------------------------------------------------
# leave blank locally so both http://localhost:3000 and http://127.0.0.1:3000 pass the same-Origin check
# when set, it is the only accepted origin and the base of every response link; use the https URL when deployed
APP_BASE_URL=
# comma-separated extra hosts allowed to load the dev server, e.g. a laptop's LAN IP (next.config.ts)
# the dev script binds 127.0.0.1, so a LAN run also needs `npx next dev --hostname 0.0.0.0`
RR_DEV_ORIGINS=
# dev only, ignored in production: comma-separated LAN hostnames (e.g. the Mac's Wi-Fi IP) whose plain-http
# APP_BASE_URL may use paid providers (AI, ElevenLabs, Twilio) with the demo identity; lets the iPhone app (ios/) reach them.
# anyone on that network can then spend your API keys while the dev server runs
RR_TRUSTED_LAN_HOSTS=
# where PGlite keeps its files; blank means .data/pglite. `npm run mvp:reset` deletes this folder
RR_PGLITE_DIR=
# 1 prints the Postgres error message to the server console (local debugging only)
RR_DB_DEBUG=
# comma-separated admin emails (demo clock controls). blank with RR_AUTH=demo makes the demo user the admin
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Claude API (RR_AI=anthropic). The SDK reads ANTHROPIC_API_KEY itself; the model is fixed in lib/ai/anthropic.ts
# ---------------------------------------------------------------------------
# secret
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Gemini (RR_AI=gemini). Being added by the AI integration; verify the names against lib/ai before use
# ---------------------------------------------------------------------------
# secret
GEMINI_API_KEY=
# blank means the adapter's default model (verify)
GEMINI_MODEL=
# only read if the embedding adapter supports Gemini (verify)
GEMINI_EMBED_MODEL=

# ---------------------------------------------------------------------------
# Supabase PostgreSQL (RR_DB=supabase), server-side only (lib/supabase/database.ts, docs/INTEGRATIONS.md)
# never give these a NEXT_PUBLIC_ prefix. the app uses no Supabase API key (anon, publishable or service role)
# ---------------------------------------------------------------------------
# secret. Session pooler URI from Supabase > Connect, with the database password URL-encoded:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# optional. Supabase CA certificate (Database Settings > SSL Configuration), as a file path or PEM text.
# set means TLS verifies the CA and hostname; blank means encrypted but unverified, with a one-time server warning
SUPABASE_DB_CA_CERT=
# optional. connections per server process; blank means 5
SUPABASE_DB_POOL_MAX=

# ---------------------------------------------------------------------------
# AWS, optional: only Claude on Amazon Bedrock and Titan embeddings. credentials come from the default AWS chain
# (for example AWS_PROFILE), never from this file
# ---------------------------------------------------------------------------
# Claude on Amazon Bedrock (RR_AI=bedrock), through the US cross-Region inference profile
BEDROCK_REGION=us-east-2
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5

# ---------------------------------------------------------------------------
# ElevenLabs speech (/api/stt Scribe v2, /api/tts Flash v2.5, optional hosted agent)
# ---------------------------------------------------------------------------
# secret. blank means voice notes show "not connected" and offer a typed note instead
ELEVENLABS_API_KEY=
# blank means the stock voice in lib/speech/runtime.ts
ELEVENLABS_VOICE_ID=
# blank means the provisioned private agent id in lib/speech/runtime.ts (docs/ELEVENLABS_AGENT.md)
ELEVENLABS_AGENT_ID=

# ---------------------------------------------------------------------------
# Texts from Urgent's "Send a text" (lib/sms/provider.ts, docs/INTEGRATIONS.md "Turn on SMS"), server-side only
# ---------------------------------------------------------------------------
# twilio | demo | blank. blank means twilio when the three TWILIO_ settings below are set, demo otherwise.
# demo stores texts in sms_outbox, shows them at /outbox and labels them simulated: nothing reaches a phone
RR_SMS=
# AC followed by 32 characters (Twilio Console > Account Info)
TWILIO_ACCOUNT_SID=
# secret
TWILIO_AUTH_TOKEN=
# the sending number in E.164 (+15875550100), or a Messaging Service SID (MG...). on a trial account this must be the
# trial number Twilio assigned to the verified recipient, or Twilio answers error 572002
TWILIO_PHONE_NUMBER=
# the live test recipient, offered as "Test phone" and shown masked; kept here so it is never in the repository
DEMO_SMS_TO=

# ---------------------------------------------------------------------------
# Google sign-in, Gmail and Calendar (lib/auth/google.ts, lib/google.ts, lib/mvp/mail.ts, lib/mvp/calendar.ts)
# The OAuth callbacks exist, but no sign-in route is mounted yet, so these do nothing on their own
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
# secret
GOOGLE_CLIENT_SECRET=
# secret. AES-256-GCM key for stored Google refresh tokens; also salts hashed IPs in response-link rate limits
APP_ENC_KEY=
# secret. NextAuth v4 signing secret, planned for the sign-in route
AUTH_SECRET=
# planned for the NextAuth v4 route; must equal APP_BASE_URL when deployed
NEXTAUTH_URL=

# ---------------------------------------------------------------------------
# Care Access (optional live classifier; the Care page and /care/access never need it)
# ---------------------------------------------------------------------------
# blank means POST /api/care-access/classify returns 503 classifier_not_configured
# local example: http://127.0.0.1:8091/classify (ml/care_access/README.md)
CARE_ACCESS_INFERENCE_URL=
# secret. bearer token sent to the inference service, if it requires one
CARE_ACCESS_INFERENCE_TOKEN=
# read only by the Python service in ml/care_access, not by the Next.js app
CARE_ACCESS_MODEL_PATH=
CARE_ACCESS_MODEL_BUCKET=
CARE_ACCESS_MODEL_KEY=
CARE_ACCESS_OSRM_URL=

# ---------------------------------------------------------------------------
# Data and scripts
# ---------------------------------------------------------------------------
# secret, optional. Socrata app token for scripts/fetch-calgary-data.ts (avoids the shared IP throttle)
SOCRATA_APP_TOKEN=
# base URL for scripts/mvp-smoke.ts; blank means http://localhost:3000. use http://127.0.0.1:3000 with npm run dev
SMOKE_BASE_URL=

# ---------------------------------------------------------------------------
# Planned, not read by any code yet (P1 scheduler and deployment)
# ---------------------------------------------------------------------------
S3_BUCKET=
APP_SECRET_ARN=
SCHEDULER_ROLE_ARN=
DISPATCHER_LAMBDA_ARN=
# secret
INTERNAL_WEBHOOK_SECRET=
